# Server Configuration
PORT=3000

# MongoDB Connection String (Secure URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/samartha?retryWrites=true&w=majority

# Gmail SMTP for Candidate Notifications (Use Google App Password)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Admin Console Secret Password
ADMIN_PASSWORD=change_this_admin_password

# Published Google Sheet CSV URL for Selected Teams
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?output=csv

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SAMARTHA 2026 // Beyond the Multiverse - VIIT CSE</title>
  <meta name="description"
    content="SAMARTHA: Indian Ingenuity. AI Innovation. Global Impact. 24 hrs Hackathon Assembled by Dept of CSE, Vignan's Institute of Information Technology (Autonomous), Visakhapatnam.">
  <link rel="icon" type="image/jpeg" href="assets/samartha_logo.jpg">

  <!-- Google Fonts for Tactical Marvel / Avengers & Cyberpunk Aesthetics -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&family=Orbitron:wght@500;700;800;900&family=Rajdhani:wght@500;600;700&family=Syne:wght@400;600;700;800&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="styles.css?v=3.8">

  <!-- Google Model Viewer for Spider-Man 3D Asset -->
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>

  <style>
    body.gateway-mode {
      overflow: hidden !important;
      height: 100vh;
      height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 50% 36%, #1a050d 0%, #0d0205 48%, #030004 88%, #000000 100%) !important;
    }

    .spiderman-page-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      width: 100%;
      max-width: 900px;
      padding: 1rem;
      position: relative;
      z-index: 5;
    }

    .skip-to-main-link {
      margin-top: 1.4rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: rgba(255, 255, 255, 0.45);
      text-decoration: none;
      letter-spacing: 1.5px;
      transition: color 0.25s, transform 0.25s;
    }

    .skip-to-main-link:hover {
      color: #00ff88;
      transform: translateX(4px);
    }
  </style>
</head>

<body class="theme-emerald gateway-mode">
  <!-- Fallout Ash / Emerald Energy Canvas -->
  <canvas id="fallout-canvas"></canvas>

  <!-- CRT Monitor Scanline & Vignette Overlay -->
  <div class="crt-overlay" id="crt-overlay"></div>
  <div class="vignette-overlay"></div>

  <div class="spiderman-page-content">
    <!-- SAMARTHA Title with Spider-Man 3D Model Resting on Top -->
    <div class="hero-title-wrapper" id="hero-title-wrapper">
      <div class="spiderman-resting-scene" id="spiderman-scene">
        <model-viewer id="spiderman-viewer" src="assets/spiderman.glb" alt="Spider-Man resting on SAMARTHA"
          interaction-prompt="none" interpolation-decay="0" shadow-intensity="1.2" shadow-softness="0.5"
          exposure="1.3" animation-name="Spidey" autoplay camera-orbit="5deg 88deg 5.6m"
          camera-target="0m 0.05m -1.25m"
          style="width: 100%; height: 100%; --poster-color: transparent; pointer-events: none;"
          class="spiderman-model-viewer"></model-viewer>
      </div>
      <h1 class="hero-samartha-title" aria-label="SAMARTHA">
        <img src="assets/samartha_title_true_transparent.png" alt="SAMARTHA" class="hero-title-img">
      </h1>
    </div>

    <div class="hero-subtitle-tagline">
      INDIAN INGENUITY. <span class="highlight-gold">AI INNOVATION.</span> GLOBAL IMPACT.
    </div>
    <div class="hero-sub-sub-tagline">
      SAME MINDS • BIGGER IMPACT // HACK THE FUTURE
    </div>

    <!-- Gateway Portal Trigger: "BEYOND THE MULTIVERSE" -->
    <div class="enter-world-gate-wrapper" id="enter-world-gate">
      <button class="enter-world-btn" id="enter-world-btn" aria-label="Beyond the Multiverse">
        <span class="enter-world-btn-glow"></span>
        <span class="enter-world-btn-icon">⚡</span>
        <span class="enter-world-btn-label">BEYOND THE MULTIVERSE</span>
        <span class="enter-world-btn-arrow">➔</span>
      </button>
    </div>

    <a href="/home" class="skip-to-main-link" id="skip-link">ENTER HACKATHON DIRECTLY →</a>
  </div>

  <script src="script.js?v=3.8"></script>
</body>

</html>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Selected Teams // SAMARTHA 2026 - Top 100 Squads</title>
  <meta name="description"
    content="Official list of the top 100 squads selected for the SAMARTHA 2026 24-hour hackathon finale at VIIT, Visakhapatnam (Oct 10-11).">
  <link rel="icon" type="image/jpeg" href="/assets/samartha_logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=Syne:wght@400;600;700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #020805; --surface: #0a1b12; --surface-2: #11281c;
      --accent: #00ff88; --accent-dim: rgba(0, 255, 136, .14); --accent-glow: rgba(0, 255, 136, .45);
      --gold: #fbbf24; --gold-dim: rgba(251, 191, 36, .15); --cyan: #00f0ff;
      --border: rgba(0, 255, 136, .22); --text: #e1f2e8; --muted: #8ea89a; --dim: #4d6859;
      --ease: cubic-bezier(.16, 1, .3, 1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Syne', sans-serif; color: var(--text); min-height: 100vh;
      background:
        radial-gradient(ellipse at 20% 0%, rgba(0, 255, 136, .12), transparent 55%),
        radial-gradient(ellipse at 90% 30%, rgba(0, 240, 255, .07), transparent 50%),
        linear-gradient(rgba(0, 255, 136, .04) 1px, transparent 1px) 0 0 / 40px 40px,
        linear-gradient(90deg, rgba(0, 255, 136, .04) 1px, transparent 1px) 0 0 / 40px 40px,
        var(--bg);
    }
    a { color: inherit; text-decoration: none; }
    .wrap { max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

    /* Top bar */
    .topbar { position: sticky; top: 0; z-index: 100; backdrop-filter: blur(14px);
      background: rgba(2, 8, 5, .88); border-bottom: 1px solid var(--border); }
    .topbar .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; }
    .brand { font-family: 'Orbitron'; font-weight: 900; letter-spacing: 4px; font-size: 1.15rem;
      color: var(--accent); text-shadow: 0 0 18px var(--accent-glow); display: flex; align-items: center; gap: 8px; }
    .back-btn { font-family: 'JetBrains Mono'; font-size: .78rem; font-weight: 700; padding: .55rem 1rem;
      border: 1px solid var(--border); border-radius: 4px; color: var(--accent); transition: all .25s var(--ease); }
    .back-btn:hover { background: var(--accent-dim); border-color: var(--accent); box-shadow: 0 0 18px var(--accent-glow); }

    /* Hero */
    .hero { text-align: center; padding: 4.5rem 0 2.5rem; }
    .tag { display: inline-block; font-family: 'JetBrains Mono'; font-size: .75rem; letter-spacing: 3px;
      color: var(--gold); border: 1px solid rgba(251, 191, 36, .45); background: rgba(251, 191, 36, .08);
      padding: .4rem 1rem; border-radius: 30px; margin-bottom: 1.4rem; animation: fadeUp .7s var(--ease) both; }
    h1 { font-family: 'Orbitron'; font-weight: 900; font-size: clamp(2rem, 6vw, 4rem); letter-spacing: 3px; line-height: 1.1;
      background: linear-gradient(135deg, #fff 10%, var(--accent) 60%, var(--cyan));
      -webkit-background-clip: text; background-clip: text; color: transparent; animation: fadeUp .7s .08s var(--ease) both; }
    .hero p { color: var(--muted); max-width: 680px; margin: 1.2rem auto 0; line-height: 1.7; animation: fadeUp .7s .16s var(--ease) both; }

    .hero-action-pill {
      display: inline-flex; align-items: center; gap: .6rem; margin-top: 1.6rem;
      background: rgba(0, 255, 136, .08); border: 1px solid rgba(0, 255, 136, .35);
      border-radius: 50px; padding: .65rem 1.4rem; font-family: 'JetBrains Mono'; font-size: .8rem;
      color: var(--accent); text-shadow: 0 0 10px rgba(0, 255, 136, .3); animation: fadeUp .7s .2s var(--ease) both;
    }

    .stats { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; animation: fadeUp .7s .24s var(--ease) both; }
    .stat { background: rgba(10, 27, 18, .7); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.6rem; min-width: 150px; }
    .stat b { display: block; font-family: 'Orbitron'; font-size: 1.7rem; color: var(--accent); }
    .stat span { font-family: 'JetBrains Mono'; font-size: .68rem; color: var(--dim); letter-spacing: 2px; }

    /* Controls */
    .controls { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin: 1rem 0 1.6rem; }
    .search { flex: 1 1 280px; position: relative; }
    .search input { width: 100%; background: var(--surface); border: 1px solid var(--border); color: #fff;
      font-family: 'Rajdhani'; font-size: 1.05rem; font-weight: 600; padding: .85rem 1rem .85rem 2.8rem; border-radius: 6px;
      outline: none; transition: all .25s var(--ease); }
    .search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
    .search::before { content: '⌕'; position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.3rem; }
    .chips { display: flex; gap: .5rem; flex-wrap: wrap; }
    .chip { font-family: 'JetBrains Mono'; font-size: .7rem; font-weight: 700; padding: .5rem .85rem; border-radius: 30px;
      border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; transition: all .2s var(--ease); }
    .chip:hover { color: #fff; border-color: var(--accent); }
    .chip.active { background: var(--accent); color: #020805; border-color: var(--accent); box-shadow: 0 0 16px var(--accent-glow); }

    /* Teams Grid & Clickable Cards */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.1rem; padding-bottom: 5rem; }
    .card {
      position: relative; background: linear-gradient(160deg, rgba(17, 40, 28, .92), rgba(10, 27, 18, .92));
      border: 1px solid var(--border); border-radius: 10px; padding: 1.3rem 1.3rem 1.1rem; overflow: hidden;
      transition: transform .25s var(--ease), border-color .25s, box-shadow .25s; animation: fadeUp .6s var(--ease) both;
      cursor: pointer; user-select: none;
    }
    .card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, transparent 30%, rgba(0, 255, 136, .08), transparent 70%);
      transform: translateX(-100%); transition: transform .7s var(--ease); }
    .card:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 14px 34px rgba(0, 255, 136, .22); }
    .card:hover::after { transform: translateX(100%); }

    /* Already Registered / Confirmed Card Style */
    .card.is-confirmed {
      border-color: rgba(251, 191, 36, .5);
      background: linear-gradient(160deg, rgba(17, 40, 28, .95), rgba(251, 191, 36, .07));
    }
    .card.is-confirmed:hover {
      border-color: var(--gold); box-shadow: 0 14px 34px rgba(251, 191, 36, .25);
    }

    /* Unlocked for correction by organizer */
    .card.is-correction {
      border-color: var(--cyan);
      box-shadow: 0 0 15px rgba(0, 240, 255, .25);
    }

    .rank { position: absolute; top: 1rem; right: 1.1rem; font-family: 'Orbitron'; font-weight: 900; font-size: 1.5rem; color: var(--gold); text-shadow: 0 0 14px rgba(251, 191, 36, .3); }
    .team { font-family: 'Rajdhani'; font-weight: 700; font-size: 1.35rem; color: #fff; padding-right: 3rem; line-height: 1.2; }
    .college { color: #a4c9b5; font-size: .9rem; margin: .6rem 0 .7rem; display: flex; align-items: flex-start; gap: .5rem; line-height: 1.4; }
    .col-icon { font-size: 1rem; line-height: 1.2; flex-shrink: 0; }
    .col-name { color: #d4ede2; font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 1rem; letter-spacing: .3px; }
    
    .lead-badge {
      font-size: .75rem; color: var(--muted); margin-bottom: .6rem; font-family: 'JetBrains Mono';
      display: flex; align-items: center; gap: 6px; background: rgba(0, 0, 0, .25); padding: .25rem .5rem; border-radius: 4px; border: 1px solid rgba(0, 255, 136, .1);
    }
    .theme { display: inline-block; font-family: 'JetBrains Mono'; font-size: .68rem; font-weight: 700; color: var(--accent);
      background: var(--accent-dim); border: 1px solid var(--border); padding: .3rem .65rem; border-radius: 4px; }

    /* Action button at bottom of card */
    .card-footer-action {
      margin-top: .9rem; padding-top: .75rem; border-top: 1px dashed rgba(0, 255, 136, .18);
      display: flex; align-items: center; justify-content: space-between; font-family: 'JetBrains Mono'; font-size: .73rem;
      color: var(--accent); font-weight: 600;
    }
    .card-footer-action span.action-btn {
      display: inline-flex; align-items: center; gap: 6px; background: rgba(0, 255, 136, .12);
      padding: .3rem .75rem; border-radius: 4px; border: 1px solid rgba(0, 255, 136, .25);
      transition: all .2s; width: 100%; justify-content: center;
    }
    .card:hover .card-footer-action span.action-btn { background: var(--accent); color: #020805; border-color: var(--accent); }

    .card.is-confirmed .card-footer-action span.action-btn {
      background: rgba(251, 191, 36, .12); border-color: rgba(251, 191, 36, .3); color: var(--gold);
    }
    .card.is-confirmed:hover .card-footer-action span.action-btn {
      background: var(--gold); color: #020805; border-color: var(--gold);
    }

    .card.is-correction .card-footer-action span.action-btn {
      background: rgba(0, 240, 255, .15); border-color: var(--cyan); color: var(--cyan);
    }

    .empty { text-align: center; color: var(--muted); padding: 4rem 1rem; border: 1px dashed var(--border); border-radius: 10px; font-family: 'JetBrains Mono'; }

    /* ========================================================
       IMMERSIVE TEAM ACCESS PORTAL (MODAL)
       ======================================================== */
    .team-portal-overlay {
      position: fixed; inset: 0; z-index: 1000; background: rgba(2, 8, 5, .92);
      backdrop-filter: blur(16px); display: none; align-items: center; justify-content: center;
      padding: 1.5rem; overflow-y: auto;
    }
    .team-portal-overlay.open { display: flex; }

    .portal-box {
      background: linear-gradient(175deg, #0d2317 0%, #05100a 100%);
      border: 1px solid var(--accent); border-radius: 16px;
      box-shadow: 0 0 60px rgba(0, 255, 136, .28), 0 25px 60px rgba(0, 0, 0, .85);
      max-width: 860px; width: 100%; max-height: 92vh; overflow-y: auto;
      padding: 2.2rem; position: relative; animation: portalEnter .35s var(--ease);
    }

    .portal-topbar {
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 1rem; border-bottom: 1px solid rgba(0, 255, 136, .18); padding-bottom: 1.2rem; margin-bottom: 1.8rem;
    }
    .portal-tag {
      font-family: 'JetBrains Mono'; font-size: .72rem; font-weight: 700; letter-spacing: 2px;
      color: var(--accent); background: var(--accent-dim); padding: .25rem .75rem; border-radius: 20px;
      display: inline-block; margin-bottom: .4rem; border: 1px solid var(--border);
    }
    .portal-title {
      font-family: 'Orbitron'; font-weight: 900; font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      color: #fff; line-height: 1.2; letter-spacing: 1.5px;
    }
    .portal-subtitle { font-family: 'Rajdhani'; font-size: 1.05rem; color: var(--muted); margin-top: .2rem; }
    
    .btn-portal-close {
      background: rgba(255, 77, 109, .1); border: 1px solid rgba(255, 77, 109, .3);
      color: #ff859c; font-family: 'JetBrains Mono'; font-size: .78rem; font-weight: 700;
      padding: .5rem 1rem; border-radius: 6px; cursor: pointer; transition: all .2s; flex-shrink: 0;
    }
    .btn-portal-close:hover { background: #ff4d6d; color: #fff; border-color: #ff4d6d; }

    /* Dossier section (Locked sheet data) */
    .dossier-wrap {
      background: rgba(17, 40, 28, .55); border: 1px solid rgba(0, 255, 136, .2);
      border-radius: 10px; padding: 1.3rem; margin-bottom: 2rem;
    }
    .dossier-head {
      display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;
      font-family: 'JetBrains Mono'; font-size: .76rem; font-weight: 700; color: var(--gold); letter-spacing: 1px;
    }
    .dossier-badge-locked {
      background: rgba(0, 255, 136, .12); color: var(--accent); border: 1px solid var(--border);
      padding: .2rem .6rem; border-radius: 4px; font-size: .68rem;
    }
    .dossier-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .9rem;
    }
    .dossier-chip {
      background: rgba(5, 16, 10, .7); border: 1px solid rgba(0, 255, 136, .12);
      border-radius: 6px; padding: .65rem .85rem;
    }
    .dossier-chip .lbl { font-family: 'JetBrains Mono'; font-size: .68rem; color: var(--dim); display: block; margin-bottom: 2px; }
    .dossier-chip .val { font-family: 'Rajdhani'; font-size: 1.05rem; font-weight: 600; color: #e1f2e8; word-break: break-all; }

    /* Unlocked correction alert banner */
    .correction-banner {
      background: rgba(0, 240, 255, .1); border: 1px solid var(--cyan); border-radius: 8px;
      padding: .9rem 1.1rem; margin-bottom: 1.6rem; font-family: 'JetBrains Mono'; font-size: .8rem;
      color: var(--cyan); line-height: 1.5; display: none;
    }

    /* Already Registered Screen inside Portal */
    .portal-registered-view {
      display: none; text-align: center; padding: 1.5rem 1rem;
      background: rgba(0, 255, 136, .05); border: 1px solid rgba(0, 255, 136, .3);
      border-radius: 12px; margin-top: 1rem;
    }
    .reg-check-icon { font-size: 3rem; margin-bottom: .6rem; }
    .reg-check-title { font-family: 'Orbitron'; font-size: 1.4rem; font-weight: 900; color: var(--accent); margin-bottom: .4rem; }
    .reg-check-desc { color: var(--muted); font-size: .95rem; line-height: 1.6; max-width: 580px; margin: 0 auto 1.5rem; }
    
    .reg-summary-card {
      background: rgba(10, 27, 18, .8); border: 1px solid var(--border); border-radius: 8px;
      padding: 1.2rem; max-width: 540px; margin: 0 auto 1.5rem; text-align: left;
      font-family: 'JetBrains Mono'; font-size: .8rem;
    }
    .reg-summary-row { display: flex; justify-content: space-between; margin-bottom: .45rem; }
    .reg-summary-row span.lbl { color: var(--dim); }
    .reg-summary-row span.val { color: var(--accent); font-weight: 700; }

    /* Submitted Members List in Locked View */
    .reg-members-box {
      margin-top: .8rem; padding-top: .8rem; border-top: 1px dashed rgba(0, 255, 136, .2);
    }
    .reg-member-item {
      background: rgba(5, 16, 10, .7); border: 1px solid rgba(0, 255, 136, .1);
      border-radius: 4px; padding: .4rem .7rem; margin-top: .4rem; font-size: .75rem;
      display: flex; justify-content: space-between; align-items: center;
    }

    /* Active Registration Form inside Portal */
    .portal-form-view { display: none; }
    .form-segment { margin-bottom: 1.8rem; }
    .form-sec-title {
      font-family: 'Orbitron'; font-size: 1rem; font-weight: 700; letter-spacing: 1.5px;
      color: #fff; margin-bottom: .3rem; display: flex; align-items: center; justify-content: space-between;
    }
    .form-sec-sub { font-family: 'JetBrains Mono'; font-size: .74rem; color: var(--dim); margin-bottom: 1rem; }

    .fields-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .9rem; }
    .form-group { display: flex; flex-direction: column; gap: .35rem; }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label {
      font-family: 'JetBrains Mono'; font-size: .72rem; font-weight: 600; color: var(--muted);
    }
    .form-group label .req { color: #ff4d6d; }
    .form-group input {
      width: 100%; background: #07150e; border: 1px solid var(--border); color: #fff;
      font-family: 'Rajdhani'; font-size: 1.05rem; font-weight: 600; padding: .7rem .9rem;
      border-radius: 6px; outline: none; transition: all .2s;
    }
    .form-group input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }

    .member-card {
      background: rgba(17, 40, 28, .35); border: 1px solid rgba(0, 255, 136, .12);
      border-radius: 8px; padding: 1rem; margin-bottom: .85rem;
    }
    .member-card-title {
      font-family: 'JetBrains Mono'; font-size: .75rem; font-weight: 700; color: var(--gold);
      letter-spacing: 1px; margin-bottom: .75rem;
    }

    /* File Dropzone */
    .dropzone {
      border: 2px dashed rgba(0, 255, 136, .3); border-radius: 8px; padding: 1.4rem 1rem;
      text-align: center; background: rgba(10, 27, 18, .5); cursor: pointer; transition: all .2s;
      position: relative;
    }
    .dropzone:hover, .dropzone.dragover { border-color: var(--accent); background: rgba(0, 255, 136, .08); }
    .dropzone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
    .dropzone-title { font-family: 'Rajdhani'; font-weight: 700; font-size: 1.05rem; color: #fff; }
    .dropzone-sub { font-family: 'JetBrains Mono'; font-size: .7rem; color: var(--dim); margin-top: .2rem; }

    .file-preview {
      display: none; align-items: center; gap: 1rem; margin-top: .8rem;
      background: rgba(0, 255, 136, .08); border: 1px solid var(--accent);
      border-radius: 6px; padding: .6rem 1rem;
    }
    .file-thumb { width: 44px; height: 44px; border-radius: 4px; object-fit: cover; border: 1px solid var(--accent); }
    .file-details { flex: 1; text-align: left; }
    .file-name { font-family: 'JetBrains Mono'; font-size: .78rem; color: #fff; font-weight: 600; word-break: break-all; }
    .file-size { font-family: 'JetBrains Mono'; font-size: .68rem; color: var(--muted); }
    .btn-remove-file { background: transparent; border: none; color: #ff4d6d; cursor: pointer; font-size: 1.2rem; }

    .btn-portal-submit {
      width: 100%; padding: 1.1rem; border-radius: 8px; border: none;
      background: linear-gradient(135deg, #00ff88 0%, #00d670 100%);
      color: #020805; font-family: 'Orbitron'; font-weight: 900; font-size: 1rem; letter-spacing: 2px;
      cursor: pointer; transition: all .25s var(--ease); box-shadow: 0 8px 30px rgba(0, 255, 136, .3);
      display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 1.2rem;
    }
    .btn-portal-submit:hover:not(:disabled) {
      transform: translateY(-2px); box-shadow: 0 12px 38px rgba(0, 255, 136, .5); filter: brightness(1.1);
    }
    .btn-portal-submit:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

    .portal-alert {
      padding: .85rem 1.1rem; border-radius: 6px; font-family: 'JetBrains Mono'; font-size: .8rem;
      margin-top: 1rem; display: none; line-height: 1.5;
    }
    .portal-alert.error { background: rgba(255, 77, 109, .15); border: 1px solid #ff4d6d; color: #ff859c; }
    .portal-alert.success { background: rgba(0, 255, 136, .15); border: 1px solid var(--accent); color: var(--accent); }

    footer { text-align: center; color: var(--dim); font-family: 'JetBrains Mono'; font-size: .72rem; padding: 2rem 1rem; border-top: 1px solid var(--border); }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    @keyframes portalEnter { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }

    @media (max-width: 600px) {
      .hero { padding-top: 3rem; }
      .portal-box { padding: 1.4rem; }
      .stat { min-width: 120px; padding: .8rem 1rem; }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="wrap">
      <a href="/home" class="brand">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        SAMARTHA
      </a>
      <a href="/home" class="back-btn" id="back-home-btn">← BACK TO HOME</a>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="tag">[ SCREENING RESULTS // 26 - 27 SEPT ]</div>
      <h1>THE TOP 100 SQUADS</h1>
      <p>Congratulations to every team that cleared the screening round. These squads advance to the
        <strong style="color:#fff">24-hour finale on October 10 - 11, 2026</strong> at VIIT CSE Labs, Visakhapatnam.</p>

      <div class="hero-action-pill">
        <span>⚡ Click any squad box below to enter that team's verification portal</span>
      </div>

      <div class="stats">
        <div class="stat"><b><%= teams.length %></b><span>SELECTED TEAMS</span></div>
        <div class="stat"><b><%= new Set(teams.map(t => t.college).filter(Boolean)).size %></b><span>COLLEGES</span></div>
        <div class="stat"><b><%= teams.length * 4 %></b><span>HACKERS</span></div>
      </div>
    </section>

    <% if (error) { %>
      <div class="empty"><%= error %></div>
    <% } else if (!teams.length) { %>
      <div class="empty">Results will be announced soon. Stay tuned!</div>
    <% } else { %>
      <% 
        const collegeCounts = {};
        teams.forEach(t => { if (t.college) collegeCounts[t.college] = (collegeCounts[t.college] || 0) + 1; });
        const sortedColleges = Object.keys(collegeCounts).sort((a,b) => collegeCounts[b] - collegeCounts[a]);
      %>
      <div class="controls">
        <label class="search" for="team-search">
          <input type="search" id="team-search" placeholder="Search by team ID, name, or college (e.g. VIIT, Lendi, GVP, Raghu)..." autocomplete="off">
        </label>
        <% if (sortedColleges.length > 1) { %>
          <div class="chips" id="college-chips">
            <button class="chip active" data-college="">ALL COLLEGES (<%= teams.length %>)</button>
            <% sortedColleges.slice(0, 7).forEach(col => { %>
              <% 
                let shortCol = col.replace(/\(Autonomous\)|\(AUCE\)|\(VIEW\)|\(VIIT\)|\(NSRIT\)|\(ANITS\)/gi, '').trim();
                if (shortCol.length > 25) shortCol = shortCol.slice(0, 23) + '…';
              %>
              <button class="chip" data-college="<%= col.toLowerCase() %>"><%= shortCol.toUpperCase() %> (<%= collegeCounts[col] %>)</button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Top 100 Squads Grid -->
      <section class="grid" id="teams-grid">
        <% teams.forEach((t, i) => { %>
          <% 
            const cleanId = (t.id || '').toUpperCase();
            const reg = registeredMap && registeredMap[cleanId];
            const isConfirmed = reg && !reg.canSubmit;
            const isCorrection = reg && reg.canSubmit && reg.attemptsUsed > 0;
          %>
          <article class="card <%= isConfirmed ? 'is-confirmed' : '' %> <%= isCorrection ? 'is-correction' : '' %>"
            id="card-<%= (t.id || 'team-' + i).replace(/[^a-zA-Z0-9_-]/g, '') %>"
            style="animation-delay: <%= Math.min(i, 20) * 0.03 %>s"
            data-search="<%= ((t.id || '') + ' ' + (t.name || '') + ' ' + (t.leadName || '') + ' ' + (t.college || '')).toLowerCase() %>"
            data-college="<%= (t.college || '').toLowerCase() %>"
            data-theme="<%= (t.theme || '').toLowerCase() %>"
            data-id="<%= t.id || '' %>"
            data-name="<%= t.name || '' %>"
            data-lead="<%= t.leadName || '' %>"
            data-email="<%= t.leadEmail || '' %>"
            data-phone="<%= t.leadPhone || '' %>"
            data-collegename="<%= t.college || '' %>"
            data-themename="<%= t.theme || '' %>"
            data-rank="<%= t.rank %>"
            data-confirmed="<%= isConfirmed ? 'true' : 'false' %>"
            data-cansubmit="<%= (!reg || reg.canSubmit) ? 'true' : 'false' %>"
            data-reginfo='<%= JSON.stringify(reg || {}) %>'
            role="button"
            tabindex="0"
            title="Click to enter <%= t.name %> portal">
            
            <span class="rank">#<%= String(t.rank).padStart(2, '0') %></span>
            <h2 class="team"><%= t.id ? t.id + ' — ' : '' %><%= t.name %></h2>
            
            <div class="college">
              <span class="col-icon">🏛️</span>
              <span class="col-name"><%= t.college || 'VIIT (Autonomous)' %></span>
            </div>

            <% if (t.leadName) { %>
              <div class="lead-badge">
                <span style="color:var(--gold);">👑 Lead:</span> <%= t.leadName %>
              </div>
            <% } %>

            <% if (t.leadEmail) { %>
              <div class="lead-badge" style="font-size:.72rem;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <%= t.leadEmail %>
              </div>
            <% } %>

            <% if (t.theme) { %><span class="theme"><%= t.theme %></span><% } %>

            <div class="card-footer-action">
              <% if (isConfirmed) { %>
                <span class="action-btn">
                  <span>🔒 SQUAD CONFIRMED ✓</span>
                  <span>→</span>
                </span>
              <% } else if (isCorrection) { %>
                <span class="action-btn">
                  <span>✏️ UNLOCKED FOR UPDATE</span>
                  <span>→</span>
                </span>
              <% } else { %>
                <span class="action-btn">
                  <span>⚡ ENTER TEAM PORTAL</span>
                  <span>→</span>
                </span>
              <% } %>
            </div>
          </article>
        <% }) %>
      </section>
      <div class="empty" id="no-results" style="display:none; margin-bottom:4rem;">No teams match your search.</div>
    <% } %>
  </main>


<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Selected Teams // SAMARTHA 2026 - Top 100 Squads</title>
  <meta name="description"
    content="Official list of the top 100 squads selected for the SAMARTHA 2026 24-hour hackathon finale at VIIT, Visakhapatnam (Oct 10-11).">
  <link rel="icon" type="image/jpeg" href="/assets/samartha_logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=Syne:wght@400;600;700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #020805; --surface: #0a1b12; --surface-2: #11281c;
      --accent: #00ff88; --accent-dim: rgba(0, 255, 136, .14); --accent-glow: rgba(0, 255, 136, .45);
      --gold: #fbbf24; --cyan: #00f0ff;
      --border: rgba(0, 255, 136, .22); --text: #e1f2e8; --muted: #8ea89a; --dim: #4d6859;
      --ease: cubic-bezier(.16, 1, .3, 1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Syne', sans-serif; color: var(--text); min-height: 100vh;
      background:
        radial-gradient(ellipse at 20% 0%, rgba(0, 255, 136, .12), transparent 55%),
        radial-gradient(ellipse at 90% 30%, rgba(0, 240, 255, .07), transparent 50%),
        linear-gradient(rgba(0, 255, 136, .04) 1px, transparent 1px) 0 0 / 40px 40px,
        linear-gradient(90deg, rgba(0, 255, 136, .04) 1px, transparent 1px) 0 0 / 40px 40px,
        var(--bg);
    }
    a { color: inherit; text-decoration: none; }
    .wrap { max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

    /* Top bar */
    .topbar { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(14px);
      background: rgba(2, 8, 5, .82); border-bottom: 1px solid var(--border); }
    .topbar .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; }
    .brand { font-family: 'Orbitron'; font-weight: 900; letter-spacing: 4px; font-size: 1.15rem;
      color: var(--accent); text-shadow: 0 0 18px var(--accent-glow); }
    .back-btn { font-family: 'JetBrains Mono'; font-size: .78rem; font-weight: 700; padding: .55rem 1rem;
      border: 1px solid var(--border); border-radius: 4px; color: var(--accent); transition: all .25s var(--ease); }
    .back-btn:hover { background: var(--accent-dim); border-color: var(--accent); box-shadow: 0 0 18px var(--accent-glow); }

    /* Hero */
    .hero { text-align: center; padding: 4.5rem 0 2.5rem; }
    .tag { display: inline-block; font-family: 'JetBrains Mono'; font-size: .75rem; letter-spacing: 3px;
      color: var(--gold); border: 1px solid rgba(251, 191, 36, .45); background: rgba(251, 191, 36, .08);
      padding: .4rem 1rem; border-radius: 30px; margin-bottom: 1.4rem; animation: fadeUp .7s var(--ease) both; }
    h1 { font-family: 'Orbitron'; font-weight: 900; font-size: clamp(2rem, 6vw, 4rem); letter-spacing: 3px; line-height: 1.1;
      background: linear-gradient(135deg, #fff 10%, var(--accent) 60%, var(--cyan));
      -webkit-background-clip: text; background-clip: text; color: transparent; animation: fadeUp .7s .08s var(--ease) both; }
    .hero p { color: var(--muted); max-width: 640px; margin: 1.2rem auto 0; line-height: 1.7; animation: fadeUp .7s .16s var(--ease) both; }

    .stats { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 2.2rem; animation: fadeUp .7s .24s var(--ease) both; }
    .stat { background: rgba(10, 27, 18, .7); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.6rem; min-width: 150px; }
    .stat b { display: block; font-family: 'Orbitron'; font-size: 1.7rem; color: var(--accent); }
    .stat span { font-family: 'JetBrains Mono'; font-size: .68rem; color: var(--dim); letter-spacing: 2px; }

    /* Controls */
    .controls { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin: 1rem 0 1.6rem; }
    .search { flex: 1 1 280px; position: relative; }
    .search input { width: 100%; background: var(--surface); border: 1px solid var(--border); color: #fff;
      font-family: 'Rajdhani'; font-size: 1.05rem; font-weight: 600; padding: .85rem 1rem .85rem 2.8rem; border-radius: 6px;
      outline: none; transition: all .25s var(--ease); }
    .search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
    .search::before { content: '⌕'; position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.3rem; }
    .chips { display: flex; gap: .5rem; flex-wrap: wrap; }
    .chip { font-family: 'JetBrains Mono'; font-size: .7rem; font-weight: 700; padding: .5rem .85rem; border-radius: 30px;
      border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; transition: all .2s var(--ease); }
    .chip:hover { color: #fff; border-color: var(--accent); }
    .chip.active { background: var(--accent); color: #020805; border-color: var(--accent); box-shadow: 0 0 16px var(--accent-glow); }

    /* Grid */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; padding-bottom: 4rem; }
    .card { position: relative; background: linear-gradient(160deg, rgba(17, 40, 28, .9), rgba(10, 27, 18, .9));
      border: 1px solid var(--border); border-radius: 10px; padding: 1.3rem 1.3rem 1.2rem; overflow: hidden;
      transition: transform .3s var(--ease), border-color .3s, box-shadow .3s; animation: fadeUp .6s var(--ease) both; }
    .card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, transparent 30%, rgba(0, 255, 136, .08), transparent 70%);
      transform: translateX(-100%); transition: transform .7s var(--ease); }
    .card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 12px 34px rgba(0, 255, 136, .15); }
    .card:hover::after { transform: translateX(100%); }
    .rank { position: absolute; top: 1rem; right: 1.1rem; font-family: 'Orbitron'; font-weight: 900; font-size: 1.5rem; color: var(--gold); text-shadow: 0 0 14px rgba(251, 191, 36, .3); }
    .team { font-family: 'Rajdhani'; font-weight: 700; font-size: 1.35rem; color: #fff; padding-right: 3rem; line-height: 1.2; }
    .college { color: #a4c9b5; font-size: .9rem; margin: .6rem 0 .9rem; display: flex; align-items: flex-start; gap: .5rem; line-height: 1.4; }
    .col-icon { font-size: 1rem; line-height: 1.2; flex-shrink: 0; }
    .col-name { color: #d4ede2; font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 1rem; letter-spacing: .3px; }
    .theme { display: inline-block; font-family: 'JetBrains Mono'; font-size: .68rem; font-weight: 700; color: var(--accent);
      background: var(--accent-dim); border: 1px solid var(--border); padding: .3rem .65rem; border-radius: 4px; }

    .empty { text-align: center; color: var(--muted); padding: 4rem 1rem; border: 1px dashed var(--border); border-radius: 10px; font-family: 'JetBrains Mono'; }
    footer { text-align: center; color: var(--dim); font-family: 'JetBrains Mono'; font-size: .72rem; padding: 2rem 1rem; border-top: 1px solid var(--border); }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    @media (max-width: 600px) { .hero { padding-top: 3rem; } .stat { min-width: 120px; padding: .8rem 1rem; } }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="wrap">
      <a href="/home" class="brand">SAMARTHA</a>
      <a href="/home" class="back-btn" id="back-home-btn">← BACK TO HOME</a>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="tag">[ SCREENING RESULTS // 26 - 27 SEPT ]</div>
      <h1>THE TOP 100 SQUADS</h1>
      <p>Congratulations to every team that cleared the screening round. These squads advance to the
        <strong style="color:#fff">24-hour finale on October 10 - 11, 2026</strong> at VIIT CSE Labs, Visakhapatnam.</p>

      <div class="stats">
        <div class="stat"><b><%= teams.length %></b><span>SELECTED TEAMS</span></div>
        <div class="stat"><b><%= new Set(teams.map(t => t.college).filter(Boolean)).size %></b><span>COLLEGES</span></div>
        <div class="stat"><b><%= teams.length * 4 %></b><span>HACKERS</span></div>
      </div>
    </section>

    <% if (error) { %>
      <div class="empty"><%= error %></div>
    <% } else if (!teams.length) { %>
      <div class="empty">Results will be announced soon. Stay tuned!</div>
    <% } else { %>
      <% 
        const collegeCounts = {};
        teams.forEach(t => { if (t.college) collegeCounts[t.college] = (collegeCounts[t.college] || 0) + 1; });
        const sortedColleges = Object.keys(collegeCounts).sort((a,b) => collegeCounts[b] - collegeCounts[a]);
      %>
      <div class="controls">
        <label class="search" for="team-search">
          <input type="search" id="team-search" placeholder="Search by team ID, name, or college (e.g. VIIT, Lendi, GVP, Raghu)..." autocomplete="off">
        </label>
        <% if (sortedColleges.length > 1) { %>
          <div class="chips" id="college-chips">
            <button class="chip active" data-college="">ALL COLLEGES (<%= teams.length %>)</button>
            <% sortedColleges.slice(0, 7).forEach(col => { %>
              <% 
                // Short label for chip
                let shortCol = col.replace(/\(Autonomous\)|\(AUCE\)|\(VIEW\)|\(VIIT\)|\(NSRIT\)|\(ANITS\)/gi, '').trim();
                if (shortCol.length > 25) shortCol = shortCol.slice(0, 23) + '…';
              %>
              <button class="chip" data-college="<%= col.toLowerCase() %>"><%= shortCol.toUpperCase() %> (<%= collegeCounts[col] %>)</button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <section class="grid" id="teams-grid">
        <% teams.forEach((t, i) => { %>
          <article class="card" style="animation-delay: <%= Math.min(i, 20) * 0.03 %>s"
            data-search="<%= (t.id + ' ' + t.name + ' ' + t.college).toLowerCase() %>" data-college="<%= (t.college || '').toLowerCase() %>" data-theme="<%= (t.theme || '').toLowerCase() %>">
            <span class="rank">#<%= String(t.rank).padStart(2, '0') %></span>
            <h2 class="team"><%= t.id ? t.id + ' — ' : '' %><%= t.name %></h2>
            <div class="college">
              <span class="col-icon">🏛️</span>
              <span class="col-name"><%= t.college || 'VIIT (Autonomous)' %></span>
            </div>
            <% if (t.leadMail) { %><div style="font-size:.75rem;color:var(--muted);margin-bottom:.8rem;font-family:'JetBrains Mono'; display: flex; align-items: center; gap: 6px;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <%= t.leadMail %>
            </div><% } %>
            <% if (t.theme) { %><span class="theme"><%= t.theme %></span><% } %>
          </article>
        <% }) %>
      </section>
      <div class="empty" id="no-results" style="display:none; margin-bottom:4rem;">No teams match your search.</div>
    <% } %>
  </main>

  <footer>© 2026 SAMARTHA HACKATHON // DEPARTMENT OF CSE, VIIT (AUTONOMOUS)</footer>

  <script>
    (() => {
      const input = document.getElementById('team-search');
      const chips = document.querySelectorAll('#college-chips .chip');
      const cards = document.querySelectorAll('.card');
      const none = document.getElementById('no-results');
      if (!input) return;
      let selectedCol = '';
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach(c => {
          const matchSearch = !q || c.dataset.search.includes(q);
          const matchCol = !selectedCol || c.dataset.college.includes(selectedCol);
          const ok = matchSearch && matchCol;
          c.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        none.style.display = shown ? 'none' : '';
      };
      input.addEventListener('input', apply);
      chips.forEach(ch => ch.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('active'));
        ch.classList.add('active');
        selectedCol = ch.dataset.college;
        apply();
      }));
    })();
  </script>
</body>

</html>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Selected Teams // SAMARTHA 2026 - Top 100 Squads</title>
  <meta name="description"
    content="Official list of the top 100 squads selected for the SAMARTHA 2026 24-hour hackathon finale at VIIT, Visakhapatnam (Oct 10-11).">
  <link rel="icon" type="image/jpeg" href="/assets/samartha_logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=Syne:wght@400;600;700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #020805; --surface: #0a1b12; --surface-2: #11281c;
      --accent: #00ff88; --accent-dim: rgba(0, 255, 136, .14); --accent-glow: rgba(0, 255, 136, .45);
      --gold: #fbbf24; --gold-dim: rgba(251, 191, 36, .15); --cyan: #00f0ff;
      --border: rgba(0, 255, 136, .22); --text: #e1f2e8; --muted: #8ea89a; --dim: #4d6859;
      --ease: cubic-bezier(.16, 1, .3, 1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Syne', sans-serif; color: var(--text); min-height: 100vh;
      background:
        radial-gradient(ellipse at 20% 0%, rgba(0, 255, 136, .12), transparent 55%),
        radial-gradient(ellipse at 90% 30%, rgba(0, 240, 255, .07), transparent 50%),
        linear-gradient(rgba(0, 255, 136, .04) 1px, transparent 1px) 0 0 / 40px 40px,
        linear-gradient(90deg, rgba(0, 255, 136, .04) 1px, transparent 1px) 0 0 / 40px 40px,
        var(--bg);
    }
    a { color: inherit; text-decoration: none; }
    .wrap { max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }

    /* Top bar */
    .topbar { position: sticky; top: 0; z-index: 100; backdrop-filter: blur(14px);
      background: rgba(2, 8, 5, .82); border-bottom: 1px solid var(--border); }
    .topbar .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; }
    .brand { font-family: 'Orbitron'; font-weight: 900; letter-spacing: 4px; font-size: 1.15rem;
      color: var(--accent); text-shadow: 0 0 18px var(--accent-glow); display: flex; align-items: center; gap: 8px; }
    .nav-actions { display: flex; align-items: center; gap: .75rem; }
    .btn-nav-pay {
      font-family: 'JetBrains Mono'; font-size: .78rem; font-weight: 700; padding: .55rem 1rem;
      border: 1px solid var(--accent); border-radius: 4px; background: var(--accent); color: #020805;
      transition: all .25s var(--ease); display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-nav-pay:hover { filter: brightness(1.15); box-shadow: 0 0 20px var(--accent-glow); }
    .back-btn { font-family: 'JetBrains Mono'; font-size: .78rem; font-weight: 700; padding: .55rem 1rem;
      border: 1px solid var(--border); border-radius: 4px; color: var(--accent); transition: all .25s var(--ease); }
    .back-btn:hover { background: var(--accent-dim); border-color: var(--accent); box-shadow: 0 0 18px var(--accent-glow); }

    /* Hero */
    .hero { text-align: center; padding: 4.5rem 0 2.5rem; }
    .tag { display: inline-block; font-family: 'JetBrains Mono'; font-size: .75rem; letter-spacing: 3px;
      color: var(--gold); border: 1px solid rgba(251, 191, 36, .45); background: rgba(251, 191, 36, .08);
      padding: .4rem 1rem; border-radius: 30px; margin-bottom: 1.4rem; animation: fadeUp .7s var(--ease) both; }
    h1 { font-family: 'Orbitron'; font-weight: 900; font-size: clamp(2rem, 6vw, 4rem); letter-spacing: 3px; line-height: 1.1;
      background: linear-gradient(135deg, #fff 10%, var(--accent) 60%, var(--cyan));
      -webkit-background-clip: text; background-clip: text; color: transparent; animation: fadeUp .7s .08s var(--ease) both; }
    .hero p { color: var(--muted); max-width: 680px; margin: 1.2rem auto 0; line-height: 1.7; animation: fadeUp .7s .16s var(--ease) both; }

    .hero-action-pill {
      display: inline-flex; align-items: center; gap: .6rem; margin-top: 1.6rem;
      background: rgba(251, 191, 36, .08); border: 1px solid rgba(251, 191, 36, .35);
      border-radius: 50px; padding: .65rem 1.4rem; font-family: 'JetBrains Mono'; font-size: .8rem;
      color: var(--gold); text-shadow: 0 0 10px rgba(251, 191, 36, .3); animation: fadeUp .7s .2s var(--ease) both;
    }

    .stats { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; animation: fadeUp .7s .24s var(--ease) both; }
    .stat { background: rgba(10, 27, 18, .7); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.6rem; min-width: 150px; }
    .stat b { display: block; font-family: 'Orbitron'; font-size: 1.7rem; color: var(--accent); }
    .stat span { font-family: 'JetBrains Mono'; font-size: .68rem; color: var(--dim); letter-spacing: 2px; }

    /* Controls */
    .controls { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin: 1rem 0 1.6rem; }
    .search { flex: 1 1 280px; position: relative; }
    .search input { width: 100%; background: var(--surface); border: 1px solid var(--border); color: #fff;
      font-family: 'Rajdhani'; font-size: 1.05rem; font-weight: 600; padding: .85rem 1rem .85rem 2.8rem; border-radius: 6px;
      outline: none; transition: all .25s var(--ease); }
    .search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
    .search::before { content: '⌕'; position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.3rem; }
    .chips { display: flex; gap: .5rem; flex-wrap: wrap; }
    .chip { font-family: 'JetBrains Mono'; font-size: .7rem; font-weight: 700; padding: .5rem .85rem; border-radius: 30px;
      border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; transition: all .2s var(--ease); }
    .chip:hover { color: #fff; border-color: var(--accent); }
    .chip.active { background: var(--accent); color: #020805; border-color: var(--accent); box-shadow: 0 0 16px var(--accent-glow); }

    /* Teams Grid & Clickable Cards */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.1rem; padding-bottom: 2.5rem; }
    .card {
      position: relative; background: linear-gradient(160deg, rgba(17, 40, 28, .92), rgba(10, 27, 18, .92));
      border: 1px solid var(--border); border-radius: 10px; padding: 1.3rem 1.3rem 1.1rem; overflow: hidden;
      transition: transform .25s var(--ease), border-color .25s, box-shadow .25s; animation: fadeUp .6s var(--ease) both;
      cursor: pointer; user-select: none;
    }
    .card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, transparent 30%, rgba(0, 255, 136, .08), transparent 70%);
      transform: translateX(-100%); transition: transform .7s var(--ease); }
    .card:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 14px 34px rgba(0, 255, 136, .22); }
    .card:hover::after { transform: translateX(100%); }

    /* Active Selected State on Card */
    .card.is-selected {
      border-color: #00ff88;
      background: linear-gradient(160deg, rgba(0, 255, 136, .16), rgba(10, 27, 18, .96));
      box-shadow: 0 0 0 2px #00ff88, 0 16px 36px rgba(0, 255, 136, .35);
      transform: translateY(-5px) scale(1.015);
    }
    .card.is-selected .sel-indicator {
      display: flex !important;
    }

    .rank { position: absolute; top: 1rem; right: 1.1rem; font-family: 'Orbitron'; font-weight: 900; font-size: 1.5rem; color: var(--gold); text-shadow: 0 0 14px rgba(251, 191, 36, .3); }
    .team { font-family: 'Rajdhani'; font-weight: 700; font-size: 1.35rem; color: #fff; padding-right: 3rem; line-height: 1.2; }
    .college { color: #a4c9b5; font-size: .9rem; margin: .6rem 0 .7rem; display: flex; align-items: flex-start; gap: .5rem; line-height: 1.4; }
    .col-icon { font-size: 1rem; line-height: 1.2; flex-shrink: 0; }
    .col-name { color: #d4ede2; font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 1rem; letter-spacing: .3px; }
    
    .lead-badge {
      font-size: .75rem; color: var(--muted); margin-bottom: .6rem; font-family: 'JetBrains Mono';
      display: flex; align-items: center; gap: 6px; background: rgba(0, 0, 0, .25); padding: .25rem .5rem; border-radius: 4px; border: 1px solid rgba(0, 255, 136, .1);
    }
    .theme { display: inline-block; font-family: 'JetBrains Mono'; font-size: .68rem; font-weight: 700; color: var(--accent);
      background: var(--accent-dim); border: 1px solid var(--border); padding: .3rem .65rem; border-radius: 4px; }

    /* Clickable action prompt at bottom of card */
    .card-footer-action {
      margin-top: .9rem; padding-top: .75rem; border-top: 1px dashed rgba(0, 255, 136, .18);
      display: flex; align-items: center; justify-content: space-between; font-family: 'JetBrains Mono'; font-size: .73rem;
      color: var(--accent); font-weight: 600;
    }
    .card:hover .card-footer-action { color: #fff; }
    .card-footer-action span.action-btn {
      display: inline-flex; align-items: center; gap: 5px; background: rgba(0, 255, 136, .12);
      padding: .28rem .65rem; border-radius: 4px; border: 1px solid rgba(0, 255, 136, .25);
      transition: all .2s;
    }
    .card:hover .card-footer-action span.action-btn { background: var(--accent); color: #020805; border-color: var(--accent); }

    .sel-indicator {
      display: none; align-items: center; gap: 5px; background: #00ff88; color: #020805;
      font-family: 'JetBrains Mono'; font-size: .7rem; font-weight: 800; padding: .25rem .6rem;
      border-radius: 4px; letter-spacing: 1px;
    }

    .empty { text-align: center; color: var(--muted); padding: 4rem 1rem; border: 1px dashed var(--border); border-radius: 10px; font-family: 'JetBrains Mono'; }

    /* ========================================================
       PAYMENT & SQUAD CONFIRMATION SECTION
       ======================================================== */
    .payment-section {
      margin-top: 2rem; margin-bottom: 5rem;
      background: linear-gradient(180deg, rgba(10, 27, 18, .95) 0%, rgba(2, 8, 5, .98) 100%);
      border: 1px solid rgba(0, 255, 136, .35); border-radius: 16px;
      padding: 3rem 2.2rem; position: relative; overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .7), 0 0 40px rgba(0, 255, 136, .08);
    }
    .payment-section::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, transparent, var(--accent), var(--gold), var(--cyan), transparent);
    }

    .section-head { text-align: center; max-width: 820px; margin: 0 auto 2.4rem; }
    .section-head .sec-tag {
      display: inline-block; font-family: 'JetBrains Mono'; font-size: .75rem; font-weight: 700;
      letter-spacing: 3px; color: var(--accent); border: 1px solid var(--border);
      background: var(--accent-dim); padding: .35rem 1rem; border-radius: 30px; margin-bottom: .8rem;
    }
    .section-head h2 {
      font-family: 'Orbitron'; font-weight: 900; font-size: clamp(1.6rem, 4vw, 2.5rem);
      letter-spacing: 2px; color: #fff; line-height: 1.2;
    }
    .section-head p { color: var(--muted); font-size: .95rem; margin-top: .6rem; line-height: 1.6; }

    /* Team Selection Banner inside payment section */
    .selection-banner {
      background: rgba(0, 255, 136, .06); border: 1px solid var(--accent);
      border-radius: 10px; padding: 1rem 1.4rem; margin-bottom: 2.2rem;
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
      animation: pulseGlow 3s infinite alternate;
    }
    .selection-banner.no-team {
      background: rgba(251, 191, 36, .08); border-color: rgba(251, 191, 36, .45);
      animation: none;
    }
    .sel-info { display: flex; align-items: center; gap: .8rem; font-family: 'Rajdhani'; font-size: 1.15rem; font-weight: 600; }
    .sel-info .status-icon { font-size: 1.4rem; }
    .sel-info .highlight { color: var(--accent); font-weight: 700; }
    .selection-banner.no-team .sel-info .highlight { color: var(--gold); }
    .btn-change-team {
      font-family: 'JetBrains Mono'; font-size: .75rem; font-weight: 700;
      background: transparent; color: var(--muted); border: 1px solid var(--border);
      padding: .45rem .85rem; border-radius: 4px; cursor: pointer; transition: all .2s;
    }
    .btn-change-team:hover { color: #fff; border-color: var(--accent); background: var(--accent-dim); }

    /* Split Layout: QR Gateway (Left) & Form (Right) */
    .pay-grid {
      display: grid; grid-template-columns: 360px 1fr; gap: 2.4rem; align-items: start;
    }
    @media (max-width: 1024px) {
      .pay-grid { grid-template-columns: 1fr; }
    }

    /* Left: UPI Payment Card */
    .qr-card {
      background: rgba(5, 16, 10, .85); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.8rem; text-align: center;
      position: sticky; top: 80px;
    }
    .qr-badge {
      display: inline-block; font-family: 'JetBrains Mono'; font-size: .7rem; font-weight: 700;
      letter-spacing: 2px; color: var(--gold); border: 1px solid rgba(251, 191, 36, .35);
      background: var(--gold-dim); padding: .3rem .8rem; border-radius: 4px; margin-bottom: 1rem;
    }
    .qr-fee { font-family: 'Orbitron'; font-weight: 900; font-size: 2rem; color: #fff; margin-bottom: .2rem; }
    .qr-fee-sub { font-family: 'JetBrains Mono'; font-size: .72rem; color: var(--dim); margin-bottom: 1.3rem; }
    
    .qr-box {
      width: 230px; height: 230px; margin: 0 auto 1.2rem; background: #fff;
      border: 2px solid var(--accent); border-radius: 12px; padding: 10px;
      box-shadow: 0 0 25px rgba(0, 255, 136, .25); position: relative;
    }
    .qr-box img { width: 100%; height: 100%; object-fit: contain; display: block; border-radius: 6px; }
    
    .upi-pill {
      background: rgba(17, 40, 28, .8); border: 1px solid var(--border); border-radius: 8px;
      padding: .65rem .8rem; display: flex; align-items: center; justify-content: space-between;
      gap: .5rem; margin-bottom: 1rem; font-family: 'JetBrains Mono'; font-size: .8rem;
    }
    .upi-pill span { color: var(--accent); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .btn-copy {
      background: var(--accent-dim); border: 1px solid var(--accent); color: var(--accent);
      border-radius: 4px; padding: .3rem .6rem; font-family: 'JetBrains Mono'; font-size: .7rem;
      cursor: pointer; transition: all .2s; flex-shrink: 0;
    }
    .btn-copy:hover { background: var(--accent); color: #020805; }

    .apps-row { display: flex; justify-content: center; gap: .7rem; align-items: center; margin-bottom: 1.2rem; }
    .app-tag { font-family: 'JetBrains Mono'; font-size: .65rem; color: var(--muted); border: 1px solid rgba(255,255,255,.08); padding: .25rem .5rem; border-radius: 4px; }

    .steps-list { text-align: left; font-family: 'Rajdhani'; font-size: .95rem; color: var(--muted); line-height: 1.5; border-top: 1px solid rgba(0, 255, 136, .1); padding-top: 1rem; }
    .steps-list li { margin-bottom: .45rem; list-style-position: inside; }

    /* Right: The Form */
    .form-box {
      background: rgba(5, 16, 10, .75); border: 1px solid var(--border);
      border-radius: 12px; padding: 2rem;
    }
    .form-segment { margin-bottom: 2rem; border-bottom: 1px solid rgba(0, 255, 136, .12); padding-bottom: 1.8rem; }
    .form-segment:last-of-type { border-bottom: none; margin-bottom: 1rem; padding-bottom: 0; }
    
    .segment-title {
      font-family: 'Orbitron'; font-size: 1.05rem; font-weight: 700; letter-spacing: 1.5px;
      color: #fff; margin-bottom: .4rem; display: flex; align-items: center; justify-content: space-between;
    }
    .segment-title span.badge {
      font-family: 'JetBrains Mono'; font-size: .65rem; font-weight: 700; letter-spacing: 1px;
      padding: .25rem .6rem; border-radius: 4px;
    }
    .badge-locked { background: rgba(0, 255, 136, .12); color: var(--accent); border: 1px solid var(--border); }
    .badge-user { background: rgba(251, 191, 36, .12); color: var(--gold); border: 1px solid rgba(251, 191, 36, .3); }
    .segment-desc { font-family: 'JetBrains Mono'; font-size: .75rem; color: var(--dim); margin-bottom: 1.2rem; }

    .fields-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;
    }

    .form-group { display: flex; flex-direction: column; gap: .4rem; }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label {
      font-family: 'JetBrains Mono'; font-size: .72rem; font-weight: 600; color: var(--muted);
      letter-spacing: .5px; display: flex; align-items: center; gap: 4px;
    }
    .form-group label .req { color: #ff4d6d; }
    
    .input-wrapper { position: relative; }
    .input-wrapper input, .input-wrapper select {
      width: 100%; background: #07150e; border: 1px solid var(--border); color: #fff;
      font-family: 'Rajdhani'; font-size: 1.05rem; font-weight: 600; padding: .75rem .95rem;
      border-radius: 6px; outline: none; transition: all .25s var(--ease);
    }
    .input-wrapper input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }

    /* Locked / Readonly Input Styling */
    .input-wrapper input[readonly] {
      background: rgba(0, 255, 136, .03); border-color: rgba(0, 255, 136, .2);
      color: #7ef2b5; cursor: not-allowed; padding-right: 2.2rem;
    }
    .input-wrapper input[readonly]:focus { border-color: rgba(0, 255, 136, .35); box-shadow: none; }
    .lock-icon {
      position: absolute; right: .85rem; top: 50%; transform: translateY(-50%);
      font-size: .9rem; opacity: .6; pointer-events: none;
    }

    /* Teammate Cards */
    .teammate-card {
      background: rgba(17, 40, 28, .4); border: 1px solid rgba(0, 255, 136, .15);
      border-radius: 8px; padding: 1rem; margin-bottom: .9rem;
    }
    .teammate-head {
      font-family: 'JetBrains Mono'; font-size: .76rem; font-weight: 700; color: var(--gold);
      letter-spacing: 1px; margin-bottom: .8rem; display: flex; align-items: center; gap: 6px;
    }

    /* File Dropzone */
    .dropzone {
      border: 2px dashed rgba(0, 255, 136, .3); border-radius: 8px; padding: 1.6rem 1rem;
      text-align: center; background: rgba(10, 27, 18, .5); cursor: pointer; transition: all .2s;
      position: relative;
    }
    .dropzone:hover, .dropzone.dragover {
      border-color: var(--accent); background: rgba(0, 255, 136, .08); box-shadow: 0 0 20px rgba(0, 255, 136, .15);
    }
    .dropzone input[type="file"] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .dropzone-icon { font-size: 2rem; margin-bottom: .4rem; }
    .dropzone-title { font-family: 'Rajdhani'; font-weight: 700; font-size: 1.1rem; color: #fff; }
    .dropzone-sub { font-family: 'JetBrains Mono'; font-size: .72rem; color: var(--dim); margin-top: .2rem; }
    
    .file-preview {
      display: none; align-items: center; gap: 1rem; margin-top: .8rem;
      background: rgba(0, 255, 136, .08); border: 1px solid var(--accent);
      border-radius: 6px; padding: .6rem 1rem;
    }
    .file-thumb { width: 44px; height: 44px; border-radius: 4px; object-fit: cover; border: 1px solid var(--accent); }
    .file-details { flex: 1; text-align: left; }
    .file-name { font-family: 'JetBrains Mono'; font-size: .78rem; color: #fff; font-weight: 600; word-break: break-all; }
    .file-size { font-family: 'JetBrains Mono'; font-size: .68rem; color: var(--muted); }
    .btn-remove-file {
      background: transparent; border: none; color: #ff4d6d; cursor: pointer;
      font-size: 1.2rem; padding: .2rem .4rem; transition: transform .2s;
    }
    .btn-remove-file:hover { transform: scale(1.2); }

    /* Submit Button */
    .btn-submit {
      width: 100%; padding: 1.1rem; border-radius: 8px; border: none;
      background: linear-gradient(135deg, #00ff88 0%, #00d670 100%);
      color: #020805; font-family: 'Orbitron'; font-weight: 900; font-size: 1rem; letter-spacing: 2px;
      cursor: pointer; transition: all .25s var(--ease); box-shadow: 0 8px 30px rgba(0, 255, 136, .3);
      display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 1rem;
    }
    .btn-submit:hover:not(:disabled) {
      transform: translateY(-2px); box-shadow: 0 12px 38px rgba(0, 255, 136, .5); filter: brightness(1.1);
    }
    .btn-submit:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

    /* Status Alert inside form */
    .form-alert {
      padding: .85rem 1.1rem; border-radius: 6px; font-family: 'JetBrains Mono'; font-size: .8rem;
      margin-top: 1rem; display: none; line-height: 1.5;
    }
    .form-alert.error { background: rgba(255, 77, 109, .15); border: 1px solid #ff4d6d; color: #ff859c; }
    .form-alert.success { background: rgba(0, 255, 136, .15); border: 1px solid var(--accent); color: var(--accent); }

    /* Modal for submission receipt */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(2, 8, 5, .88); backdrop-filter: blur(10px);
      z-index: 1000; display: none; align-items: center; justify-content: center; padding: 1.5rem;
    }
    .modal-box {
      background: linear-gradient(160deg, #0a1b12, #05100a); border: 1px solid var(--accent);
      box-shadow: 0 0 50px rgba(0, 255, 136, .35); border-radius: 14px;
      max-width: 540px; width: 100%; padding: 2.5rem 2rem; text-align: center;
      position: relative; animation: fadeUp .4s var(--ease);
    }
    .modal-icon { font-size: 3.2rem; margin-bottom: .8rem; }
    .modal-box h3 { font-family: 'Orbitron'; font-weight: 900; font-size: 1.6rem; color: #fff; margin-bottom: .6rem; }
    .modal-box p { color: var(--muted); font-size: .95rem; line-height: 1.6; margin-bottom: 1.5rem; }
    .modal-slip {
      background: rgba(17, 40, 28, .7); border: 1px solid var(--border); border-radius: 8px;
      padding: 1.1rem; text-align: left; margin-bottom: 1.6rem; font-family: 'JetBrains Mono'; font-size: .8rem;
    }
    .modal-slip .row { display: flex; justify-content: space-between; margin-bottom: .45rem; }
    .modal-slip .row span.lbl { color: var(--dim); }
    .modal-slip .row span.val { color: var(--accent); font-weight: 700; }
    .btn-modal-close {
      font-family: 'JetBrains Mono'; font-weight: 700; font-size: .85rem; padding: .8rem 2rem;
      border-radius: 6px; background: var(--accent); color: #020805; border: none; cursor: pointer;
    }
    .btn-modal-close:hover { filter: brightness(1.1); box-shadow: 0 0 20px var(--accent-glow); }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    @keyframes pulseGlow { 0% { box-shadow: 0 0 10px rgba(0,255,136,.1); } 100% { box-shadow: 0 0 25px rgba(0,255,136,.25); } }

    @media (max-width: 600px) {
      .hero { padding-top: 3rem; }
      .stat { min-width: 120px; padding: .8rem 1rem; }
      .payment-section { padding: 2rem 1.2rem; }
      .form-box { padding: 1.2rem; }
      .qr-card { position: static; }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="wrap">
      <a href="/home" class="brand">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        SAMARTHA
      </a>
      <div class="nav-actions">
        <a href="#payment-section" class="btn-nav-pay" id="btn-top-pay">⚡ CONFIRM SQUAD & PAY</a>
        <a href="/home" class="back-btn" id="back-home-btn">← BACK TO HOME</a>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="tag">[ SCREENING RESULTS // 26 - 27 SEPT ]</div>
      <h1>THE TOP 100 SQUADS</h1>
      <p>Congratulations to every team that cleared the screening round. These squads advance to the
        <strong style="color:#fff">24-hour finale on October 10 - 11, 2026</strong> at VIIT CSE Labs, Visakhapatnam.</p>

      <div class="hero-action-pill">
        <span>👉 Click your team box below to auto-fill official credentials & confirm squad</span>
      </div>

      <div class="stats">
        <div class="stat"><b><%= teams.length %></b><span>SELECTED TEAMS</span></div>
        <div class="stat"><b><%= new Set(teams.map(t => t.college).filter(Boolean)).size %></b><span>COLLEGES</span></div>
        <div class="stat"><b><%= teams.length * 4 %></b><span>HACKERS</span></div>
      </div>
    </section>

    <% if (error) { %>
      <div class="empty"><%= error %></div>
    <% } else if (!teams.length) { %>
      <div class="empty">Results will be announced soon. Stay tuned!</div>
    <% } else { %>
      <% 
        const collegeCounts = {};
        teams.forEach(t => { if (t.college) collegeCounts[t.college] = (collegeCounts[t.college] || 0) + 1; });
        const sortedColleges = Object.keys(collegeCounts).sort((a,b) => collegeCounts[b] - collegeCounts[a]);
      %>
      <div class="controls">
        <label class="search" for="team-search">
          <input type="search" id="team-search" placeholder="Search by team ID, name, or college (e.g. VIIT, Lendi, GVP, Raghu)..." autocomplete="off">
        </label>
        <% if (sortedColleges.length > 1) { %>
          <div class="chips" id="college-chips">
            <button class="chip active" data-college="">ALL COLLEGES (<%= teams.length %>)</button>
            <% sortedColleges.slice(0, 7).forEach(col => { %>
              <% 
                let shortCol = col.replace(/\(Autonomous\)|\(AUCE\)|\(VIEW\)|\(VIIT\)|\(NSRIT\)|\(ANITS\)/gi, '').trim();
                if (shortCol.length > 25) shortCol = shortCol.slice(0, 23) + '…';
              %>
              <button class="chip" data-college="<%= col.toLowerCase() %>"><%= shortCol.toUpperCase() %> (<%= collegeCounts[col] %>)</button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Selected Teams Grid -->
      <section class="grid" id="teams-grid">
        <% teams.forEach((t, i) => { %>
          <article class="card" id="card-<%= (t.id || 'team-' + i).replace(/[^a-zA-Z0-9_-]/g, '') %>"
            style="animation-delay: <%= Math.min(i, 20) * 0.03 %>s"
            data-search="<%= ((t.id || '') + ' ' + (t.name || '') + ' ' + (t.leadName || '') + ' ' + (t.college || '')).toLowerCase() %>"
            data-college="<%= (t.college || '').toLowerCase() %>"
            data-theme="<%= (t.theme || '').toLowerCase() %>"
            data-id="<%= t.id || '' %>"
            data-name="<%= t.name || '' %>"
            data-lead="<%= t.leadName || '' %>"
            data-email="<%= t.leadEmail || '' %>"
            data-phone="<%= t.leadPhone || '' %>"
            data-collegename="<%= t.college || '' %>"
            data-themename="<%= t.theme || '' %>"
            data-rank="<%= t.rank %>"
            role="button"
            tabindex="0"
            title="Click to select <%= t.name %> and complete payment">
            
            <span class="rank">#<%= String(t.rank).padStart(2, '0') %></span>
            <h2 class="team"><%= t.id ? t.id + ' — ' : '' %><%= t.name %></h2>
            
            <div class="college">
              <span class="col-icon">🏛️</span>
              <span class="col-name"><%= t.college || 'VIIT (Autonomous)' %></span>
            </div>

            <% if (t.leadName) { %>
              <div class="lead-badge">
                <span style="color:var(--gold);">👑 Lead:</span> <%= t.leadName %>
              </div>
            <% } %>

            <% if (t.leadEmail) { %>
              <div class="lead-badge" style="font-size:.72rem;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <%= t.leadEmail %>
              </div>
            <% } %>

            <% if (t.theme) { %><span class="theme"><%= t.theme %></span><% } %>

            <div class="card-footer-action">
              <span class="action-btn">
                <span>⚡ Select & Confirm</span>
                <span>→</span>
              </span>
              <span class="sel-indicator">SELECTED ✓</span>
            </div>
          </article>
        <% }) %>
      </section>
      <div class="empty" id="no-results" style="display:none; margin-bottom:4rem;">No teams match your search.</div>

      <!-- ========================================================
           PAYMENT & SQUAD VERIFICATION SECTION
           ======================================================== -->
      <section class="payment-section" id="payment-section">
        <div class="section-head">
          <div class="sec-tag">[ STEP 2: FINALE REGISTRATION & PAYMENT ]</div>
          <h2>SQUAD CONFIRMATION & PAYMENT</h2>
          <p>
            Click any team card in the shortlist grid above. Your team credentials from the official screening results will automatically lock into place. Fill in your squad members and upload your payment receipt below.
          </p>
        </div>

        <!-- Dynamic Selection Alert Banner -->
        <div class="selection-banner no-team" id="selection-banner">
          <div class="sel-info">
            <span class="status-icon" id="banner-icon">👆</span>
            <div>
              <span id="banner-text">Please click your <strong>Team Card</strong> above to activate registration.</span>
              <div id="banner-sub" style="font-family:'JetBrains Mono'; font-size:.75rem; color:var(--muted); margin-top:2px;">
                Details are fetched directly from the official screening sheet.
              </div>
            </div>
          </div>
          <button type="button" class="btn-change-team" id="btn-change-team" style="display:none;">
            Change Team ↑
          </button>
        </div>

        <div class="pay-grid">
          <!-- Left: UPI Gateway Card -->
          <div class="qr-card">
            <span class="qr-badge">OFFICIAL UPI GATEWAY</span>
            <div class="qr-fee">₹1,000</div>
            <div class="qr-fee-sub">PER SQUAD (₹250 / Hacker • 4 Members)</div>

            <div class="qr-box">
              <img id="payment-qr-img" src="/assets/payment_qr.jpg" onerror="this.onerror=null; this.src='/assets/website_qr.png';" alt="SAMARTHA 2026 Payment QR">
            </div>

            <div class="upi-pill">
              <span id="upi-id-text">9281057369@ybl</span>
              <button type="button" class="btn-copy" id="btn-copy-upi" title="Copy UPI ID">COPY</button>
            </div>

            <div class="apps-row">
              <span class="app-tag">GPay</span>
              <span class="app-tag">PhonePe</span>
              <span class="app-tag">Paytm</span>
              <span class="app-tag">BHIM</span>
              <span class="app-tag">Cred</span>
            </div>

            <ul class="steps-list">
              <li>1. Click your team box above to lock details.</li>
              <li>2. Scan QR or transfer ₹1,000 to official UPI ID.</li>
              <li>3. Note the 12-digit UTR / Reference ID.</li>
              <li>4. Add 3 squad members & upload screenshot.</li>
            </ul>
          </div>

          <!-- Right: Verification Form -->
          <div class="form-box">
            <form id="payment-form" enctype="multipart/form-data">
              <!-- SEGMENT 1: Locked Team Information -->
              <div class="form-segment">
                <div class="segment-title">
                  <span>1. TEAM CREDENTIALS</span>
                  <span class="badge badge-locked">🔒 LOCKED (OFFICIAL SHEET)</span>
                </div>
                <div class="segment-desc">
                  These fields auto-populate when you click your card above. They cannot be altered to maintain screening authenticity.
                </div>

                <div class="fields-grid">
                  <div class="form-group">
                    <label>Team ID <span class="req">*</span></label>
                    <div class="input-wrapper">
                      <input type="text" id="f-team-id" name="teamId" readonly placeholder="Click card above (e.g. AV_001)" required>
                      <span class="lock-icon">🔒</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Team Name <span class="req">*</span></label>
                    <div class="input-wrapper">
                      <input type="text" id="f-team-name" name="teamName" readonly placeholder="Select team above" required>
                      <span class="lock-icon">🔒</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Team Lead Name <span class="req">*</span></label>
                    <div class="input-wrapper">
                      <input type="text" id="f-lead-name" name="teamLeadName" readonly placeholder="Lead name from sheet" required>
                      <span class="lock-icon">🔒</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Team Lead Email <span class="req">*</span></label>
                    <div class="input-wrapper">
                      <input type="email" id="f-lead-email" name="teamLeadEmail" readonly placeholder="Lead email from sheet" required>
                      <span class="lock-icon">🔒</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Team Lead Contact</label>
                    <div class="input-wrapper">
                      <input type="text" id="f-lead-phone" name="teamLeadPhone" readonly placeholder="Lead phone from sheet">
                      <span class="lock-icon">🔒</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>College Institution</label>
                    <div class="input-wrapper">
                      <input type="text" id="f-college" name="college" readonly placeholder="College from sheet">
                      <span class="lock-icon">🔒</span>
                    </div>
                  </div>

                  <input type="hidden" id="f-theme" name="theme">
                </div>
              </div>

              <!-- SEGMENT 2: Squad Members (User Entered) -->
              <div class="form-segment">
                <div class="segment-title">
                  <span>2. SQUAD MEMBERS ROSTER</span>
                  <span class="badge badge-user">✍️ USER DETAILS</span>
                </div>
                <div class="segment-desc">
                  Provide details for the remaining 3 squad members who will accompany the Team Lead (Total 4 Hackers).
                </div>

                <!-- Teammate 2 -->
                <div class="teammate-card">
                  <div class="teammate-head">👤 SQUAD MEMBER 2</div>
                  <div class="fields-grid">
                    <div class="form-group">
                      <label>Full Name <span class="req">*</span></label>
                      <div class="input-wrapper">
                        <input type="text" name="member1Name" id="f-m1-name" placeholder="Teammate 2 full name" required>
                      </div>
                    </div>
                    <div class="form-group">
                      <label>Email / Roll No</label>
                      <div class="input-wrapper">
                        <input type="text" name="member1Email" id="f-m1-email" placeholder="Email or College Roll No">
                      </div>
                    </div>
                    <div class="form-group">
                      <label>WhatsApp / Mobile</label>
                      <div class="input-wrapper">
                        <input type="tel" name="member1Phone" id="f-m1-phone" placeholder="10-digit Mobile">
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Teammate 3 -->
                <div class="teammate-card">
                  <div class="teammate-head">👤 SQUAD MEMBER 3</div>
                  <div class="fields-grid">
                    <div class="form-group">
                      <label>Full Name <span class="req">*</span></label>
                      <div class="input-wrapper">
                        <input type="text" name="member2Name" id="f-m2-name" placeholder="Teammate 3 full name" required>
                      </div>
                    </div>
                    <div class="form-group">
                      <label>Email / Roll No</label>
                      <div class="input-wrapper">
                        <input type="text" name="member2Email" id="f-m2-email" placeholder="Email or College Roll No">
                      </div>
                    </div>
                    <div class="form-group">
                      <label>WhatsApp / Mobile</label>
                      <div class="input-wrapper">
                        <input type="tel" name="member2Phone" id="f-m2-phone" placeholder="10-digit Mobile">
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Teammate 4 -->
                <div class="teammate-card">
                  <div class="teammate-head">👤 SQUAD MEMBER 4</div>
                  <div class="fields-grid">
                    <div class="form-group">
                      <label>Full Name <span class="req">*</span></label>
                      <div class="input-wrapper">
                        <input type="text" name="member3Name" id="f-m3-name" placeholder="Teammate 4 full name" required>
                      </div>
                    </div>
                    <div class="form-group">
                      <label>Email / Roll No</label>
                      <div class="input-wrapper">
                        <input type="text" name="member3Email" id="f-m3-email" placeholder="Email or College Roll No">
                      </div>
                    </div>
                    <div class="form-group">
                      <label>WhatsApp / Mobile</label>
                      <div class="input-wrapper">
                        <input type="tel" name="member3Phone" id="f-m3-phone" placeholder="10-digit Mobile">
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- SEGMENT 3: Payment Verification & Proof -->
              <div class="form-segment">
                <div class="segment-title">
                  <span>3. PAYMENT PROOF & UTR</span>
                  <span class="badge badge-user">💳 TRANSACTION</span>
                </div>
                <div class="segment-desc">
                  Enter your 12-digit UPI / Bank Reference Number and upload a clear screenshot of the transaction.
                </div>

                <div class="fields-grid" style="margin-bottom:1.2rem;">
                  <div class="form-group full">
                    <label>UPI / UTR Transaction ID (12 Digits) <span class="req">*</span></label>
                    <div class="input-wrapper">
                      <input type="text" name="utrId" id="f-utr-id" placeholder="e.g. 428719283741 or UPI Reference" maxlength="32" required style="text-transform:uppercase; letter-spacing:1px; font-family:'JetBrains Mono';">
                    </div>
                    <span style="font-family:'JetBrains Mono'; font-size:.68rem; color:var(--dim);">Found in your payment app (Google Pay, PhonePe, Paytm) under transaction details.</span>
                  </div>

                  <div class="form-group full">
                    <label>Upload Payment Screenshot <span class="req">*</span></label>
                    <div class="dropzone" id="dropzone">
                      <input type="file" name="screenshot" id="f-screenshot" accept="image/jpeg,image/png,image/webp,application/pdf" required>
                      <div class="dropzone-icon">📸</div>
                      <div class="dropzone-title">Click to Browse or Drag & Drop Screenshot</div>
                      <div class="dropzone-sub">Supported formats: JPG, PNG, WEBP, PDF (Max 8MB)</div>
                    </div>

                    <div class="file-preview" id="file-preview">
                      <img src="" id="file-preview-thumb" class="file-thumb" alt="Preview">
                      <div class="file-details">
                        <div class="file-name" id="file-preview-name">receipt.png</div>
                        <div class="file-size" id="file-preview-size">1.2 MB</div>
                      </div>
                      <button type="button" class="btn-remove-file" id="btn-remove-file" title="Remove file">✕</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Status Alert -->
              <div class="form-alert" id="form-alert"></div>

              <!-- Submit -->
              <button type="submit" class="btn-submit" id="btn-submit">
                <span>SUBMIT SQUAD & CONFIRM PAYMENT</span>
                <span id="submit-spinner" style="display:none;">⏳</span>
              </button>
            </form>
          </div>
        </div>
      </section>
    <% } %>
  </main>

  <!-- Submission Receipt Modal -->
  <div class="modal-overlay" id="success-modal">
    <div class="modal-box">
      <div class="modal-icon">🎉</div>
      <h3>REGISTRATION SUBMITTED!</h3>
      <p>Your team roster and payment receipt have been recorded securely in the SAMARTHA 2026 database.</p>
      
      <div class="modal-slip">
        <div class="row"><span class="lbl">Team ID:</span><span class="val" id="m-team-id">-</span></div>
        <div class="row"><span class="lbl">Team Name:</span><span class="val" id="m-team-name">-</span></div>
        <div class="row"><span class="lbl">Transaction UTR:</span><span class="val" id="m-utr-id">-</span></div>
        <div class="row"><span class="lbl">Amount:</span><span class="val">₹1,000 (4 Members)</span></div>
        <div class="row"><span class="lbl">Status:</span><span class="val" style="color:var(--gold);">Under Verification ✓</span></div>
      </div>

      <p style="font-size:.82rem; color:var(--dim); margin-bottom:1.5rem;">
        The organizing committee will verify your payment against bank records. Official entry passes will be sent to the Team Lead's email.
      </p>

      <button type="button" class="btn-modal-close" id="btn-modal-close">DONE / CLOSE</button>
    </div>
  </div>

  <footer>© 2026 SAMARTHA HACKATHON // DEPARTMENT OF CSE, VIIT (AUTONOMOUS)</footer>

  <script>
    (() => {
      // ----------------- Filter & Search Logic -----------------
      const input = document.getElementById('team-search');
      const chips = document.querySelectorAll('#college-chips .chip');
      const cards = document.querySelectorAll('.card');
      const none = document.getElementById('no-results');

      let selectedCol = '';
      const applyFilter = () => {
        if (!input) return;
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach(c => {
          const matchSearch = !q || c.dataset.search.includes(q);
          const matchCol = !selectedCol || c.dataset.college.includes(selectedCol);
          const ok = matchSearch && matchCol;
          c.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        if (none) none.style.display = shown ? 'none' : '';
      };

      if (input) input.addEventListener('input', applyFilter);
      chips.forEach(ch => ch.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('active'));
        ch.classList.add('active');
        selectedCol = ch.dataset.college;
        applyFilter();
      }));

      // ----------------- Team Card Click & Auto-Fill Logic -----------------
      const paymentSection = document.getElementById('payment-section');
      const banner = document.getElementById('selection-banner');
      const bannerIcon = document.getElementById('banner-icon');
      const bannerText = document.getElementById('banner-text');
      const bannerSub = document.getElementById('banner-sub');
      const btnChangeTeam = document.getElementById('btn-change-team');

      // Locked form inputs
      const fTeamId = document.getElementById('f-team-id');
      const fTeamName = document.getElementById('f-team-name');
      const fLeadName = document.getElementById('f-lead-name');
      const fLeadEmail = document.getElementById('f-lead-email');
      const fLeadPhone = document.getElementById('f-lead-phone');
      const fCollege = document.getElementById('f-college');
      const fTheme = document.getElementById('f-theme');

      const selectTeamCard = (card) => {
        // 1. Remove selected state from all other cards
        cards.forEach(c => c.classList.remove('is-selected'));
        card.classList.add('is-selected');

        // 2. Extract official sheet data attributes
        const teamId = card.dataset.id || '';
        const teamName = card.dataset.name || '';
        const leadName = card.dataset.lead || '';
        const leadEmail = card.dataset.email || '';
        const leadPhone = card.dataset.phone || '';
        const college = card.dataset.collegename || '';
        const theme = card.dataset.themename || '';

        // 3. Populate locked fields
        if (fTeamId) fTeamId.value = teamId;
        if (fTeamName) fTeamName.value = teamName;
        if (fLeadName) fLeadName.value = leadName;
        if (fLeadEmail) fLeadEmail.value = leadEmail;
        if (fLeadPhone) fLeadPhone.value = leadPhone;
        if (fCollege) fCollege.value = college;
        if (fTheme) fTheme.value = theme;

        // 4. Update banner
        if (banner) {
          banner.classList.remove('no-team');
          bannerIcon.textContent = '⚡';
          bannerText.innerHTML = `Selected: <span class="highlight">[${teamId}] ${teamName}</span> • Lead: <strong>${leadName || 'Verified'}</strong> • College: <strong>${college}</strong>`;
          bannerSub.textContent = '🔒 Details locked from official screening results. Complete member and payment details below.';
          if (btnChangeTeam) btnChangeTeam.style.display = 'inline-block';
        }

        // 5. Smooth scroll down to payment section
        if (paymentSection) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // 6. Focus on Member 2 Name if empty
        const m1 = document.getElementById('f-m1-name');
        if (m1 && !m1.value) {
          setTimeout(() => m1.focus(), 600);
        }
      };

      cards.forEach(card => {
        card.addEventListener('click', () => selectTeamCard(card));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            selectTeamCard(card);
          }
        });
      });

      if (btnChangeTeam) {
        btnChangeTeam.addEventListener('click', () => {
          const grid = document.getElementById('teams-grid');
          if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      // ----------------- Copy UPI ID -----------------
      const btnCopy = document.getElementById('btn-copy-upi');
      const upiText = document.getElementById('upi-id-text');
      if (btnCopy && upiText) {
        btnCopy.addEventListener('click', () => {
          navigator.clipboard.writeText(upiText.textContent.trim()).then(() => {
            const prev = btnCopy.textContent;
            btnCopy.textContent = 'COPIED! ✓';
            setTimeout(() => { btnCopy.textContent = prev; }, 2000);
          }).catch(() => {
            alert('UPI ID: ' + upiText.textContent.trim());
          });
        });
      }

      // ----------------- File Dropzone & Preview -----------------
      const fileInput = document.getElementById('f-screenshot');
      const dropzone = document.getElementById('dropzone');
      const filePreview = document.getElementById('file-preview');
      const previewThumb = document.getElementById('file-preview-thumb');
      const previewName = document.getElementById('file-preview-name');
      const previewSize = document.getElementById('file-preview-size');
      const btnRemoveFile = document.getElementById('btn-remove-file');

      const handleFile = (file) => {
        if (!file) return;
        const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
        if (!validTypes.includes(file.type)) {
          alert('Please upload a valid JPG, PNG, WEBP image or PDF receipt.');
          return;
        }
        if (file.size > 8 * 1024 * 1024) {
          alert('File size exceeds 8MB. Please upload a smaller receipt.');
          return;
        }

        previewName.textContent = file.name;
        previewSize.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';

        if (file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = (e) => {
            previewThumb.src = e.target.result;
            previewThumb.style.display = 'block';
          };
          reader.readAsDataURL(file);
        } else {
          previewThumb.style.display = 'none';
        }

        dropzone.style.display = 'none';
        filePreview.style.display = 'flex';
      };

      if (fileInput) {
        fileInput.addEventListener('change', (e) => {
          if (e.target.files && e.target.files[0]) {
            handleFile(e.target.files[0]);
          }
        });
      }

      if (btnRemoveFile) {
        btnRemoveFile.addEventListener('click', () => {
          if (fileInput) fileInput.value = '';
          filePreview.style.display = 'none';
          dropzone.style.display = 'block';
        });
      }

      // Drag and drop events
      if (dropzone) {
        ['dragenter', 'dragover'].forEach(name => {
          dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(name => {
          dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.classList.remove('dragover'); });
        });
        dropzone.addEventListener('drop', (e) => {
          if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            fileInput.files = e.dataTransfer.files;
            handleFile(e.dataTransfer.files[0]);
          }
        });
      }

      // ----------------- Form Submission to Backend -----------------
      const form = document.getElementById('payment-form');
      const alertBox = document.getElementById('form-alert');
      const btnSubmit = document.getElementById('btn-submit');
      const spinner = document.getElementById('submit-spinner');
      const successModal = document.getElementById('success-modal');
      const btnModalClose = document.getElementById('btn-modal-close');

      const showAlert = (msg, isError = true) => {
        if (!alertBox) return;
        alertBox.textContent = msg;
        alertBox.className = 'form-alert ' + (isError ? 'error' : 'success');
        alertBox.style.display = 'block';
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          alertBox.style.display = 'none';

          // Validate team selection
          if (!fTeamId || !fTeamId.value || !fTeamName || !fTeamName.value) {
            showAlert('Please select your team box from the Top 100 list above before submitting.', true);
            const grid = document.getElementById('teams-grid');
            if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
          }

          // Validate UTR
          const utr = document.getElementById('f-utr-id').value.trim();
          if (!utr || utr.length < 6) {
            showAlert('Please enter a valid UPI / UTR Transaction ID (e.g. 12 digits).', true);
            return;
          }

          // Validate File
          if (!fileInput.files || !fileInput.files[0]) {
            showAlert('Please upload your payment screenshot receipt.', true);
            return;
          }

          // Prepare FormData
          const formData = new FormData(form);

          btnSubmit.disabled = true;
          spinner.style.display = 'inline-block';

          try {
            const res = await fetch('/api/payment/submit', {
              method: 'POST',
              body: formData
            });

            const data = await res.json();

            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Failed to submit payment details. Please check your inputs.');
            }

            // Populate Modal
            document.getElementById('m-team-id').textContent = data.teamId || fTeamId.value;
            document.getElementById('m-team-name').textContent = data.teamName || fTeamName.value;
            document.getElementById('m-utr-id').textContent = data.utrId || utr;

            // Show success modal
            if (successModal) {
              successModal.style.display = 'flex';
            }

            form.reset();
            if (btnRemoveFile) btnRemoveFile.click();
          } catch (err) {
            showAlert(err.message || 'An error occurred during submission. Please try again.', true);
          } finally {
            btnSubmit.disabled = false;
            spinner.style.display = 'none';
          }
        });
      }

      if (btnModalClose && successModal) {
        btnModalClose.addEventListener('click', () => {
          successModal.style.display = 'none';
        });
      }
    })();
  </script>
</body>

</html>

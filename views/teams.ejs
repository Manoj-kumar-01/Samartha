  <script>
    (() => {
      // ----------------- Filter & Search -----------------
      const input = document.getElementById('team-search');
      const chips = document.querySelectorAll('#college-chips .chip');
      const cards = document.querySelectorAll('.card');
      const none = document.getElementById('no-results');

      let selectedCol = '';
      const applyFilter = () => {
        if (!input) return;
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach(c => {
          const matchSearch = !q || c.dataset.search.includes(q);
          const matchCol = !selectedCol || c.dataset.college.includes(selectedCol);
          const ok = matchSearch && matchCol;
          c.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        if (none) none.style.display = shown ? 'none' : '';
      };

      if (input) input.addEventListener('input', applyFilter);
      chips.forEach(ch => ch.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('active'));
        ch.classList.add('active');
        selectedCol = ch.dataset.college;
        applyFilter();
      }));

      // ----------------- Team Portal Logic -----------------
      const overlay = document.getElementById('portal-overlay');
      const btnClose = document.getElementById('btn-portal-close');
      const btnReturn = document.getElementById('btn-portal-return');

      const pTitle = document.getElementById('p-title');
      const pSubtitle = document.getElementById('p-subtitle');
      const pDossierId = document.getElementById('p-dossier-id');
      const pDossierLead = document.getElementById('p-dossier-lead');
      const pDossierEmail = document.getElementById('p-dossier-email');
      const pDossierPhone = document.getElementById('p-dossier-phone');
      const pDossierCollege = document.getElementById('p-dossier-college');
      const pCorrectionBanner = document.getElementById('p-correction-banner');
      const pCorrectionMsg = document.getElementById('p-correction-msg');

      const formView = document.getElementById('portal-form-view');
      const registeredView = document.getElementById('portal-registered-view');
      const pRegId = document.getElementById('p-reg-id');
      const pRegName = document.getElementById('p-reg-name');
      const pRegUtr = document.getElementById('p-reg-utr');
      const pRegAttempts = document.getElementById('p-reg-attempts');
      const pRegMembersList = document.getElementById('p-reg-members-list');

      // Hidden form inputs
      const fTeamId = document.getElementById('form-team-id');
      const fTeamName = document.getElementById('form-team-name');
      const fLeadName = document.getElementById('form-lead-name');
      const fLeadEmail = document.getElementById('form-lead-email');
      const fLeadPhone = document.getElementById('form-lead-phone');
      const fCollege = document.getElementById('form-college');
      const fTheme = document.getElementById('form-theme');

      // Member inputs for prefill
      const m1Name = document.getElementById('m1-name');
      const m1Email = document.getElementById('m1-email');
      const m1Phone = document.getElementById('m1-phone');
      const m2Name = document.getElementById('m2-name');
      const m2Email = document.getElementById('m2-email');
      const m2Phone = document.getElementById('m2-phone');
      const m3Name = document.getElementById('m3-name');
      const m3Email = document.getElementById('m3-email');
      const m3Phone = document.getElementById('m3-phone');
      const fUtr = document.getElementById('f-utr-id');

      let currentCard = null;

      const openTeamPortal = (card) => {
        currentCard = card;
        const id = card.dataset.id || '';
        const name = card.dataset.name || '';
        const lead = card.dataset.lead || '';
        const email = card.dataset.email || '';
        const phone = card.dataset.phone || '';
        const college = card.dataset.collegename || '';
        const theme = card.dataset.themename || '';
        const rank = card.dataset.rank || '';
        const canSubmit = card.dataset.cansubmit === 'true';

        let regInfo = {};
        try {
          regInfo = JSON.parse(card.dataset.reginfo || '{}');
        } catch (e) {}

        // Populate header & dossier
        pTitle.textContent = (id ? id + ' // ' : '') + name;
        pSubtitle.textContent = college + (rank ? ` • Rank #${String(rank).padStart(2, '0')}` : '');
        pDossierId.textContent = id || 'N/A';
        pDossierLead.textContent = lead || 'Verified';
        pDossierEmail.textContent = email || 'Official Sheet Record';
        pDossierPhone.textContent = phone || 'Official Sheet Record';
        pDossierCollege.textContent = college || 'VIIT (Autonomous)';

        // Populate hidden form inputs
        fTeamId.value = id;
        fTeamName.value = name;
        fLeadName.value = lead;
        fLeadEmail.value = email;
        fLeadPhone.value = phone;
        fCollege.value = college;
        fTheme.value = theme;

        const isCorrection = canSubmit && regInfo.attemptsUsed > 0;

        if (!canSubmit) {
          // Locked view (single fill used, cannot edit unless unlocked in Atlas)
          formView.style.display = 'none';
          registeredView.style.display = 'block';
          pCorrectionBanner.style.display = 'none';

          pRegId.textContent = id;
          pRegName.textContent = name;
          pRegUtr.textContent = regInfo.utrId || 'VERIFIED ON FILE';
          pRegAttempts.textContent = `${regInfo.attemptsUsed || 1} of ${regInfo.attemptsAllowed || 1} Used (Locked in Atlas)`;

          // Render members list
          if (pRegMembersList) {
            pRegMembersList.innerHTML = '';
            if (regInfo.members && regInfo.members.length) {
              regInfo.members.forEach((m, idx) => {
                const item = document.createElement('div');
                item.className = 'reg-member-item';
                item.innerHTML = `<span>👤 Member ${idx + 2}: <b>${m.name}</b></span><span>${m.phone || m.email || ''}</span>`;
                pRegMembersList.appendChild(item);
              });
            } else {
              pRegMembersList.innerHTML = '<span style="color:var(--dim); font-size:.7rem;">Roster details saved on server</span>';
            }
          }
        } else {
          // Editable form view (first time OR unlocked by coordinator in Atlas)
          registeredView.style.display = 'none';
          formView.style.display = 'block';
          const alert = document.getElementById('portal-alert');
          if (alert) alert.style.display = 'none';

          if (isCorrection) {
            pCorrectionBanner.style.display = 'block';
            pCorrectionMsg.textContent = `✏️ UNLOCKED IN ATLAS FOR CORRECTION (Attempt ${regInfo.attemptsUsed + 1} of ${regInfo.attemptsAllowed}): Review and update your details below.`;
            // Pre-fill existing data for easy correction
            if (regInfo.members && regInfo.members[0]) {
              m1Name.value = regInfo.members[0].name || '';
              m1Email.value = regInfo.members[0].email || '';
              m1Phone.value = regInfo.members[0].phone || '';
            }
            if (regInfo.members && regInfo.members[1]) {
              m2Name.value = regInfo.members[1].name || '';
              m2Email.value = regInfo.members[1].email || '';
              m2Phone.value = regInfo.members[1].phone || '';
            }
            if (regInfo.members && regInfo.members[2]) {
              m3Name.value = regInfo.members[2].name || '';
              m3Email.value = regInfo.members[2].email || '';
              m3Phone.value = regInfo.members[2].phone || '';
            }
            if (regInfo.utrId) fUtr.value = regInfo.utrId;
          } else {
            pCorrectionBanner.style.display = 'none';
          }

          setTimeout(() => {
            if (m1Name) m1Name.focus();
          }, 200);
        }

        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      };

      // Ensure scrolling is ALWAYS cleanly restored
      const closeTeamPortal = () => {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
        if (currentCard) {
          currentCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      };

      cards.forEach(card => {
        card.addEventListener('click', () => openTeamPortal(card));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openTeamPortal(card);
          }
        });
      });

      if (btnClose) btnClose.addEventListener('click', closeTeamPortal);
      if (btnReturn) btnReturn.addEventListener('click', closeTeamPortal);

      if (overlay) {
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeTeamPortal();
        });
      }
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.classList.contains('open')) {
          closeTeamPortal();
        }
      });

      // ----------------- File Dropzone -----------------
      const fileInput = document.getElementById('f-screenshot');
      const dropzone = document.getElementById('dropzone');
      const filePreview = document.getElementById('file-preview');
      const previewThumb = document.getElementById('file-preview-thumb');
      const previewName = document.getElementById('file-preview-name');
      const previewSize = document.getElementById('file-preview-size');
      const btnRemoveFile = document.getElementById('btn-remove-file');

      const handleFile = (file) => {
        if (!file) return;
        const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
        if (!validTypes.includes(file.type)) {
          alert('Please upload a valid JPG, PNG, WEBP image or PDF receipt.');
          return;
        }
        if (file.size > 8 * 1024 * 1024) {
          alert('File size exceeds 8MB. Please upload a smaller receipt.');
          return;
        }

        previewName.textContent = file.name;
        previewSize.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';

        if (file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = (e) => {
            previewThumb.src = e.target.result;
            previewThumb.style.display = 'block';
          };
          reader.readAsDataURL(file);
        } else {
          previewThumb.style.display = 'none';
        }

        dropzone.style.display = 'none';
        filePreview.style.display = 'flex';
      };

      if (fileInput) {
        fileInput.addEventListener('change', (e) => {
          if (e.target.files && e.target.files[0]) handleFile(e.target.files[0]);
        });
      }

      if (btnRemoveFile) {
        btnRemoveFile.addEventListener('click', () => {
          if (fileInput) fileInput.value = '';
          filePreview.style.display = 'none';
          dropzone.style.display = 'block';
        });
      }

      if (dropzone) {
        ['dragenter', 'dragover'].forEach(n => {
          dropzone.addEventListener(n, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(n => {
          dropzone.addEventListener(n, (e) => { e.preventDefault(); dropzone.classList.remove('dragover'); });
        });
        dropzone.addEventListener('drop', (e) => {
          if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            fileInput.files = e.dataTransfer.files;
            handleFile(e.dataTransfer.files[0]);
          }
        });
      }

      // ----------------- Submit Form to Backend -----------------
      const form = document.getElementById('portal-form');
      const alertBox = document.getElementById('portal-alert');
      const btnSubmit = document.getElementById('btn-portal-submit');
      const spinner = document.getElementById('portal-spinner');

      const showAlert = (msg, isError = true) => {
        if (!alertBox) return;
        alertBox.textContent = msg;
        alertBox.className = 'portal-alert ' + (isError ? 'error' : 'success');
        alertBox.style.display = 'block';
      };

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          alertBox.style.display = 'none';

          const utr = document.getElementById('f-utr-id').value.trim();
          if (!utr || utr.length < 6) {
            showAlert('Please enter a valid 12-digit UPI / UTR Transaction ID.', true);
            return;
          }

          if (!fileInput.files || !fileInput.files[0]) {
            showAlert('Please upload your payment screenshot receipt.', true);
            return;
          }

          const formData = new FormData(form);
          btnSubmit.disabled = true;
          spinner.style.display = 'inline-block';

          try {
            const res = await fetch('/api/payment/submit', {
              method: 'POST',
              body: formData
            });

            const data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Failed to submit registration. Each squad has 1 chance.');
            }

            // Successfully submitted! Update current card state
            if (currentCard) {
              currentCard.classList.remove('is-correction');
              currentCard.classList.add('is-confirmed');
              currentCard.dataset.confirmed = 'true';
              currentCard.dataset.cansubmit = 'false';
              const updatedReg = {
                teamId: data.teamId,
                teamName: data.teamName,
                utrId: data.utrId,
                attemptsAllowed: 1,
                attemptsUsed: 1,
                canSubmit: false,
                isLocked: true,
                members: [
                  { name: m1Name.value.trim(), email: m1Email.value.trim(), phone: m1Phone.value.trim() },
                  { name: m2Name.value.trim(), email: m2Email.value.trim(), phone: m2Phone.value.trim() },
                  { name: m3Name.value.trim(), email: m3Email.value.trim(), phone: m3Phone.value.trim() },
                ]
              };
              currentCard.dataset.reginfo = JSON.stringify(updatedReg);
              const actionSpan = currentCard.querySelector('.card-footer-action span.action-btn');
              if (actionSpan) {
                actionSpan.innerHTML = '<span>🔒 SQUAD CONFIRMED ✓</span><span>→</span>';
              }
            }

            // Switch portal to confirmed locked view
            formView.style.display = 'none';
            pCorrectionBanner.style.display = 'none';
            registeredView.style.display = 'block';
            pRegId.textContent = data.teamId;
            pRegName.textContent = data.teamName;
            pRegUtr.textContent = data.utrId;
            pRegAttempts.textContent = '1 of 1 Used (Locked in Atlas)';

            // Render members
            if (pRegMembersList) {
              pRegMembersList.innerHTML = `
                <div class="reg-member-item"><span>👤 Member 2: <b>${m1Name.value.trim()}</b></span><span>${m1Phone.value.trim() || m1Email.value.trim()}</span></div>
                <div class="reg-member-item"><span>👤 Member 3: <b>${m2Name.value.trim()}</b></span><span>${m2Phone.value.trim() || m2Email.value.trim()}</span></div>
                <div class="reg-member-item"><span>👤 Member 4: <b>${m3Name.value.trim()}</b></span><span>${m3Phone.value.trim() || m3Email.value.trim()}</span></div>
              `;
            }

            form.reset();
            if (btnRemoveFile) btnRemoveFile.click();
          } catch (err) {
            showAlert(err.message || 'Error processing registration. Please try again.', true);
          } finally {
            btnSubmit.disabled = false;
            spinner.style.display = 'none';
          }
        });
      }
    })();
  </script>
</body>

</html>
